<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.panda.merge.mapper.SportScoreShowStatusMapper">

  <resultMap id="BaseResultMap" type="com.panda.merge.model.SportScoreShowStatus" >
    <result column="id" property="id" />
    <result column="sport_id" property="sportId" />
    <result column="show_status" property="showStatus" />
    <result column="default_show_status" property="defaultShowStatus" />
    <result column="create_time" property="createTime" />
    <result column="update_time" property="updateTime" />
  </resultMap>

  <sql id="Base_Column_List">
    id,
    sport_id,
    show_status,
    default_show_status,
    create_time,
    update_time
  </sql>

  <select id="query" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List" />
    FROM sport_score_show_status
  </select>

  <update id="update" parameterType="com.panda.merge.model.SportScoreShowStatus">
    UPDATE sport_score_show_status set
      <if test="null != showStatus ">show_status = #{showStatus},</if>
      <if test="null != defaultShowStatus ">default_show_status = #{defaultShowStatus},</if>
    update_time = #{updateTime}
    WHERE id = #{id}
  </update>
</mapper>