    output += '<tr class="totals-row"><th class="add-row"><a href="#">' + soy.$$escapeHtml('Add a Row') + '</a></th><td colspan="' + soy.$$escapeHtml(opt_data.columnCount) + '" class="edit-on-first-click">&nbsp;</td><td class="right-padding">&nbsp;</td></tr>';
