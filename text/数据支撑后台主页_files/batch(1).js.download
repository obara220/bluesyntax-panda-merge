Confluence.Templates.PlaySQL.oneRow = function(opt_data, opt_ignored) {
  var output = '';
  var rowId__soy211 = opt_data.row[0][0] ? opt_data.row[0][0] : '';
  var position__soy212 = opt_data.row[1][0] ? opt_data.row[1][0] : '';
  output += '<tr data-row-id="' + soy.$$escapeHtml(rowId__soy211) + '" data-row-metadata="' + soy.$$escapeHtml(position__soy212) + '">';
