    output += '<optgroup label="Different type">';
    var rendererItemList667 = opt_data.renderers.otherTypeRenderers;
    var rendererItemListLen667 = rendererItemList667.length;
    for (var rendererItemIndex667 = 0; rendererItemIndex667 < rendererItemListLen667; rendererItemIndex667++) {
      var rendererItemData667 = rendererItemList667[rendererItemIndex667];
      output += '<option value="' + soy.$$escapeHtml(rendererItemData667.key) + '" ' + ((rendererItemData667.key == opt_data.viewRenderer) ? 'selected="selected"' : '') + '>' + soy.$$escapeHtml(rendererItemData667.name) + '</option>';
