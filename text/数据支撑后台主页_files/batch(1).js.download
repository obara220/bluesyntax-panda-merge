                return this;
            },
            /** { label, id-or-click-handler, arguments-to-be-passed-to-the-click-handler }. */
            addItem: function (labelHtml, fn, args) {
                var $li = $("<li></li>").appendTo($ul);
                $li.html(labelHtml);
                $li.data("value", fn);
                $li.find("> a").click(function (e) {
