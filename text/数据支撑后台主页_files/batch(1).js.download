try {
/* module-key = 'com.playsql.playsql-base-plugin:playsql-web', location = 'assets/core/spreadsheet/spreadsheet-macro-renderer-base.js' */
(function($){
    /**
     * The API boundary is:
     * - The TD/TH belongs to spreadsheet-macro.js,
