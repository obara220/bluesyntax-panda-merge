  for (var rendererItemIndex652 = 0; rendererItemIndex652 < rendererItemListLen652; rendererItemIndex652++) {
    var rendererItemData652 = rendererItemList652[rendererItemIndex652];
    output += '<option value="' + soy.$$escapeHtml(rendererItemData652.key) + '"' + ((rendererItemData652.key == opt_data.viewRenderer) ? 'selected="selected"' : '') + '>' + soy.$$escapeHtml(rendererItemData652.name) + '</option>';
  }
  output += '</optgroup>';
