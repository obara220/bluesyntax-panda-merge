<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.panda.merge.dao.StandardMarketCategoryDao">

    <resultMap id="childResultMap" type="com.panda.merge.dto.StandardMarketCategoryDetail" extends="com.panda.merge.mapper.StandardMarketCategoryMapper.BaseResultMap">
    </resultMap>

    <select id="getItemPageByModifyTime" parameterType="com.panda.merge.dto.StandardSportMarketCategoryDTO" resultMap="childResultMap">
        select t1.*, t2.field_type as fieldType
        from   standard_market_category t1
        left join custom_market_category t2 on t1.id = t2.market_category_id
        where  t1.modify_time &gt;= #{beginTime}
        <if test="endTime != null">
            and    t1.modify_time &lt;= #{endTime}
        </if>
        order by t1.modify_time,t1.id desc
    </select>

</mapper>