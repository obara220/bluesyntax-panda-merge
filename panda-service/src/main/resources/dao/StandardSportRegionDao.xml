<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.panda.merge.dao.StandardSportRegionDao">

    <select id="getItemPageByModifyTime" parameterType="com.panda.merge.dto.StandardSportRegionDTO" resultMap="com.panda.merge.mapper.StandardSportRegionMapper.BaseResultMap">
        select *
        from   standard_sport_region
        where  modify_time &gt;= #{beginTime}
        <if test="endTime != null">
            and    modify_time &lt;= #{endTime}
        </if>
        order by modify_time,id DESC
    </select>



</mapper>