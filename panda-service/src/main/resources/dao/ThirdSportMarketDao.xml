<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.panda.merge.dao.ThirdSportMarketDao">

    <select id="getItemPageByModifyTime" parameterType="com.panda.merge.dto.ThirdSportMarketDTO" resultMap="com.panda.merge.mapper.ThirdSportMarketMapper.BaseResultMap">
        select t1.*
        from   third_sport_market t1
        where  t1.modify_time &gt;= #{beginTime}
        <if test="endTime != null">
            and    t1.modify_time &lt;= #{endTime}
        </if>
        order by t1.modify_time,t1.id DESC
    </select>


    <select id="selectThirdSportMarketList" parameterType="java.util.Map" resultMap="com.panda.merge.mapper.ThirdSportMarketMapper.BaseResultMap">
        SELECT
            third_t.*
        FROM
            third_sport_market third_t
        WHERE
            third_t.match_id = #{thirdMatchId}
    </select>

</mapper>