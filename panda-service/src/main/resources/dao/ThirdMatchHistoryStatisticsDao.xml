    <select id="getItemPageByModifyTime" parameterType="com.panda.merge.dto.StandardMatchInfoDTO" resultMap="com.panda.merge.mapper.ThirdMatchHistoryStatisticsMapper.BaseResultMap">
        SELECT t1.*
        FROM third_match_history_statistics t1
        WHERE  t1.modify_time &gt;= #{beginTime}
        <if test="endTime != null">
            and  t1.modify_time &lt;= #{endTime}
        </if>
        order by t1.modify_time, t1.id
    </select>


