    <resultMap id="childResultMap" type="com.panda.merge.dto.StandardSportTeamDetail" extends="com.panda.merge.mapper.StandardSportTeamMapper.BaseResultMap">
        <association property="matchTeamRelation" resultMap="com.panda.merge.mapper.StandardMatchTeamRelationMapper.ResultMapWithBLOBs" columnPrefix="relation_"/>
    </resultMap>

    <select id="getItemByStandardMatchId" parameterType="java.lang.Long" resultMap="childResultMap">
        select t.*,
               mt.standard_match_id relation_standard_match_id,mt.match_position relation_match_position,mt.remark relation_remark
        from   standard_match_team_relation mt
        join   standard_sport_team t ON t.id = mt.standard_team_id
        WHERE  mt.standard_match_id = #{standardMatchId}
    </select>

    <select id="getItemByStandardTeamIds" parameterType="java.util.List" resultMap="childResultMap">
        select t.*
        from   standard_sport_team t
        WHERE  t.id IN
        <foreach item="standardTeamId" index="index" collection="standardTeamIds" open="(" separator="," close=")">
            #{standardTeamId}
        </foreach>
    </select>

